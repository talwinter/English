# English Quest settings. Copy this file to .env and fill it in:  cp .env.example .env
# After changing .env, run:  docker compose up -d

# Password for the parent page (http://SERVER:8080/admin). Any user name works.
ADMIN_PASSWORD=change-me

# Password for the art worker on the PC with the graphics card (type the same text in its installer).
WORKER_TOKEN=change-me-too

# Your MikroTik router's address.
ROUTER_HOST=192.168.1.1

# Discord locks every day at this time, on these days (0 = Sunday ... 6 = Saturday).
LOCK_TIME=08:00
LOCK_DAYS=0,1,2,3,4,5,6
# false = no daily lock at all (the parent page's "Lock now" button still works).
LOCK_ENABLED=true

# Wake the art PC at this time when pictures are waiting (empty = never wake it).
WAKE_TIME=05:00

# OpenAI, for writing new episodes (empty = no new episodes). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# true = the art PC makes one version of each picture and the server uses it by itself.
# false = it makes 3 versions and you choose one on the parent page.
AUTO_CHOOSE_ART=true

# How many new episodes to keep ready, and whether to publish them without asking you.
EPISODES_AHEAD=2
AUTO_PUBLISH=false
